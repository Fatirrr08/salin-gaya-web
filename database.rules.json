{
  "rules": {
    "users": {
      ".read": true,
      ".indexOn": ["phone", "email"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "products": {
      ".read": true,
      "$productId": {
        // Hanya bisa membuat/mengubah produk jika sellerUid cocok dengan auth.uid. Memungkinkan penghapusan (!newData.exists())
        ".write": "auth != null && (!data.exists() || data.child('sellerUid').val() == auth.uid) && (!newData.exists() || newData.child('sellerUid').val() == auth.uid)"
      }
    },
    "status": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "typing": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "public_data": {
      ".read": true,
      ".write": "auth != null"
    },
    "otp_sessions": {
      ".read": true,
      ".write": true
    },
    "reviews": {
      ".read": true,
      "$productId": {
        "$reviewId": {
          ".write": "auth != null && (!data.exists() || data.child('userId').val() == auth.uid) && (!newData.exists() || newData.child('userId').val() == auth.uid)"
        }
      }
    }
  }
}
